# HealthTech — reverse proxy TLS (Caddy 2).
# Caddy gère automatiquement les certificats Let's Encrypt.
# Les deux domaines doivent pointer sur l'IP du serveur avant le premier démarrage.

# API backend (Rust/Axum)
api.healthtech.ci {
    reverse_proxy backend:8080
}

# PWA médecin (interface web)
medecin.healthtech.ci {
    reverse_proxy pwa:80
}
