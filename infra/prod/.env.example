# HealthTech — variables d'environnement de production.
#
# INSTRUCTIONS :
#   cp infra/prod/.env.example infra/prod/.env
#   Remplir chaque valeur CHANGE_ME ci-dessous.
#   Ne jamais commiter le fichier .env dans git.
#
# GÉNÉRATION DES MOTS DE PASSE :
#   openssl rand -base64 32   → pour les mots de passe Postgres/MinIO
#   openssl rand -hex 32      → pour PRESIGNED_URL_SIGNING_KEY

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=healthtech
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=healthtech

# ── MinIO (stockage chiffré des médias) ──────────────────────────────────────
# MINIO_ACCESS_KEY : identifiant (≥ 3 caractères)
MINIO_ACCESS_KEY=CHANGE_ME_access_key
# MINIO_SECRET_KEY : mot de passe (≥ 8 caractères)
MINIO_SECRET_KEY=CHANGE_ME_openssl_rand_base64_32

# ── Clé de signature des URLs d'accès média ──────────────────────────────────
# Générer avec : openssl rand -hex 32
# Cette clé signe les URLs éphémères (TTL court) d'accès aux fichiers médecins.
# Ne jamais la réutiliser ailleurs ni la changer sans redéployer le backend.
PRESIGNED_URL_SIGNING_KEY=CHANGE_ME_openssl_rand_hex_32

# ── Domaines exposés via le companion proxy (nginx-proxy) ────────────────────
# Le réseau Docker "proxy" doit exister sur le serveur (créé par le companion).
# Ces domaines doivent pointer sur l'IP du serveur avant le premier démarrage.
BACKEND_DOMAIN=healthtech-api.staging.go.incubtek.com
PWA_DOMAIN=healthtech-medecin.staging.go.incubtek.com
