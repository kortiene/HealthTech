<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31) : splash screen système.
  windowSplashScreenAnimatedIcon lit l'icône adaptative et l'affiche
  dans un cercle centré sur windowSplashScreenBackground.
-->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#003D39</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Pas de windowSplashScreenIconBackgroundColor : le background layer
             (#003D39) du adaptive-icon sert déjà de fond dans le cercle. -->
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
